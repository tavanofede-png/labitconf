{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://tino-api-labitconf.vercel.app/api/:path*" },
    { "source": "/demo/:path*", "destination": "/index.html" },
    { "source": "/emulador/:path*", "destination": "/index.html" },
    { "source": "/web/:path*", "destination": "/index.html" },
    { "source": "/portal/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=()" }
      ]
    }
  ]
}
