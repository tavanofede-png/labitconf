<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <queries>
        <package android:name="com.google.android.gm" />
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.android.settings" />
        <package android:name="com.whatsapp" />
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>
        <intent><action android:name="android.intent.action.SENDTO" /><data android:scheme="mailto" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <application
        android:name=".NietoApp"
        android:label="TINO"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="${cleartextAllowed}"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/tino_shortcuts" />
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".family.FamilyActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".presence.OverlayActionActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="org.nieto.assistant.overlay" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service android:name=".presence.FloatingBubbleService" android:exported="false" android:foregroundServiceType="specialUse|microphone">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled edge-docked floating chat with local dictation and explicitly selected attachments." />
        </service>
        <service android:name=".shortcuts.TinoTileService" android:exported="true" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:label="TINO" android:icon="@drawable/ic_nieto"><intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter></service>
        <receiver android:name=".shortcuts.TinoWidget" android:exported="false"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/tino_widget_info" /></receiver>
        <service android:name=".voice.WakeWordService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".voice.TinoVoiceInteractionService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService" /></intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/tino_voice_interaction" />
        </service>
        <service android:name=".voice.TinoVoiceSessionService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".voice.TinoRecognitionService" android:exported="true"
            android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>
        <activity android:name=".voice.VoiceInputActivity" android:exported="false" android:excludeFromRecents="true"
            android:launchMode="singleTop" android:theme="@style/Theme.Nieto.VoiceInput" />
        <service
            android:name=".screen.NietoAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="TINO: guía en pantalla">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
