# Copiar a .env en la raíz. Las claves pertenecen únicamente al backend.
HOST=0.0.0.0
PORT=8787

# Reemplazar por un token aleatorio local antes de abrir el portal institucional.
# Generador: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
INSTITUTION_TOKEN=reemplazar-por-un-token-aleatorio-local

# Obtener una clave nueva en OpenArg. Nunca incluirla en Android ni VITE_*.
OPENARG_API_KEY=

# Cohorte mínima para mostrar desgloses de participantes en una institución.
MINIMUM_COHORT=5

# Opcionales. El endpoint MCP oficial es fijo en el backend.
OPENARG_TIMEOUT_MS=25000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATA_FILE=C:/ruta/privada/nieto.json

# Identidad por correo: configurar solo en backend, nunca en Android ni VITE_*.
# AUTH_SECRET debe tener al menos 32 caracteres aleatorios.
AUTH_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Correos verificados autorizados para el acceso institucional, separados por comas.
INSTITUTION_EMAILS=
# Solo prueba local, activar explícitamente: el código aparece en la terminal,
# nunca en la respuesta HTTP. Android lo identifica como prueba sin correo.
TINO_LOCAL_DEMO=0
