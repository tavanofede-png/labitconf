# Copiar a .env en la raíz. Las claves pertenecen únicamente al backend.
HOST=0.0.0.0
PORT=8787

# Reemplazar por un token aleatorio local antes de abrir el portal institucional.
# Generador: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
INSTITUTION_TOKEN=

# Obtener una clave nueva en OpenArg. Nunca incluirla en Android ni VITE_*.
OPENARG_API_KEY=

# OpenAI Realtime. Clave privada del backend; nunca usar prefijo VITE_ ni incluirla en el APK.
OPENAI_API_KEY=

# Cohorte mínima para mostrar desgloses de participantes en una institución.
MINIMUM_COHORT=5

# Opcionales. El endpoint MCP oficial es fijo en el backend.
OPENARG_TIMEOUT_MS=25000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATA_FILE=C:/ruta/privada/nieto.json

# Asistencia: códigos de alta emitidos por el operador; no hay alta pública sin código.
# Presupuestos de capacidad reservada por día UTC, persistidos en DATA_FILE.
# Cada socket reserva 20 turnos, 600 segundos y 60 pantallas; HTTP reserva 1 turno y 65 segundos.
# No se reembolsa una reserva al desconectar. No son consumo medido ni límites en dólares.
REALTIME_MAX_CONNECTIONS_PER_ORIGIN=2
REALTIME_DEVICE_DAILY_TURNS=60
REALTIME_DEVICE_DAILY_SECONDS=1800
REALTIME_DEVICE_DAILY_CONTEXTS=180
REALTIME_ORIGIN_DAILY_TURNS=120
REALTIME_ORIGIN_DAILY_SECONDS=3600
REALTIME_ORIGIN_DAILY_CONTEXTS=360
REALTIME_GLOBAL_DAILY_TURNS=1200
REALTIME_GLOBAL_DAILY_SECONDS=36000
REALTIME_GLOBAL_DAILY_CONTEXTS=3600
