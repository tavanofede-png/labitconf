{
  "name": "nieto",
  "version": "2.0.0",
  "private": true,
  "description": "NIETO para LABITCONF: acompañamiento digital Android y contexto público mediante OpenArg MCP.",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "api": "node --env-file-if-exists=.env apps/api/src/server.mjs",
    "web": "npm run dev --workspace @nieto/web",
    "typecheck": "npm run typecheck --workspace @nieto/web",
    "build": "npm run build --workspace @nieto/web",
    "test": "npm run test --workspace @nieto/api",
    "test:web": "npm run test --workspace @nieto/web",
    "check": "node scripts/check.mjs",
    "verify:openarg": "npm run verify:openarg --workspace @nieto/api",
    "verify:realtime": "npm run verify:realtime --workspace @nieto/api",
    "verify:screen": "npm run verify:screen --workspace @nieto/api"
  },
  "overrides": {
    "rollup": "4.59.0"
  }
}
